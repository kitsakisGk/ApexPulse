# Normalise to LF in the repository; check out native on Windows.
* text=auto

# Always LF — these are consumed by Linux containers and CI.
*.py      text eol=lf
*.toml    text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.json    text eol=lf
*.sh      text eol=lf
*.ts      text eol=lf
*.tsx     text eol=lf
*.css     text eol=lf
Dockerfile text eol=lf
.env.example text eol=lf
.gitignore text eol=lf

# Lockfiles are generated; collapse them in diffs and reviews.
uv.lock       linguist-generated=true -diff
package-lock.json linguist-generated=true -diff

# Binary artifacts.
*.parquet binary
*.duckdb  binary
*.png     binary
*.jpg     binary
