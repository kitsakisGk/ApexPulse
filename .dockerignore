# The build context is the repository root, because the API image needs
# pyproject.toml and uv.lock from it. Without this file every build would upload
# the virtualenv, node_modules, and the training data to the Docker daemon.

.git
.github
**/__pycache__
**/*.pyc
.venv
.mypy_cache
.ruff_cache
.pytest_cache
.coverage
htmlcov

frontend/node_modules
frontend/.next
frontend/out

data
models
logs
*.duckdb
*.parquet
*.sqlite3

.env
.env.*
!.env.example
