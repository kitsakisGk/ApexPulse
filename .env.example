# Copy to `.env` and adjust for your local stack: `cp .env.example .env`

# -- General --
APEXPULSE_ENVIRONMENT=local
APEXPULSE_LOG_LEVEL=INFO

# -- Backend selection --
# ApexPulse runs with no external services by default, so the full pipeline works
# on a bare machine. Switch these to kafka/redis once `docker compose up` is available.
#   broker: memory | kafka
#   state:  memory | sqlite | redis
APEXPULSE_BROKER_BACKEND=memory
APEXPULSE_STATE_BACKEND=sqlite

# -- Kafka / Redpanda --
APEXPULSE_KAFKA_BOOTSTRAP_SERVERS=localhost:19092
APEXPULSE_KAFKA_TELEMETRY_TOPIC=apexpulse.telemetry.ticks
APEXPULSE_KAFKA_PREDICTION_TOPIC=apexpulse.predictions
APEXPULSE_KAFKA_CONSUMER_GROUP=apexpulse-stream

# -- Redis --
APEXPULSE_REDIS_URL=redis://localhost:6379/0
APEXPULSE_REDIS_STATE_TTL_SECONDS=3600

# -- Simulation --
APEXPULSE_TICK_RATE_HZ=8.0

# -- API --
APEXPULSE_API_HOST=0.0.0.0
APEXPULSE_API_PORT=8000
